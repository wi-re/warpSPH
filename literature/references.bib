% The scheme of ACSPH_PLAN.md and the papers it depends on. Added 2026-09-05.

@article{decourcy2024,
  author  = {De Courcy, Joe J. and Rendall, Thomas C. S. and Constantin, Lucian and Titurus, Brano and Cooper, Jonathan E.},
  title   = {Incompressible {$\delta$}-{SPH} via artificial compressibility},
  journal = {Computer Methods in Applied Mechanics and Engineering},
  year    = {2024},
  volume  = {420},
  articleno = {116700},
  pages   = {116700},
  doi     = {10.1016/j.cma.2023.116700},
  note    = {Open access (CC BY). The ACSPH scheme ACSPH_PLAN.md implements: the WCSPH equation of state is replaced by a pressure-evolution equation marched in pseudo-time to a divergence-free state at every real time step, via BDF2 + an inner Runge-Kutta loop. Its Eq. (33) pressure bi-Laplacian is Marrone et al.'s (marrone2011) density operator with rho -> p. Precursor: De Courcy et al., SPHERIC 2023 (its ref [32], not obtained).}
}

@article{antuono2010,
  author  = {Antuono, M. and Colagrossi, A. and Marrone, S. and Molteni, D.},
  title   = {Free-surface flows solved by means of {SPH} schemes with numerical diffusive terms},
  journal = {Computer Physics Communications},
  year    = {2010},
  volume  = {181},
  number  = {3},
  pages   = {532--549},
  doi     = {10.1016/j.cpc.2009.11.002},
  note    = {Origin of the renormalised-gradient correction to the density Laplacian that decourcy2024 Eq. (33) recasts in pressure as AC-2L. Co-cited with antuono2012 for the linear stability bound behind k2 <= 0.2*h*beta.}
}

@article{antuono2012,
  author  = {Antuono, M. and Colagrossi, A. and Marrone, S.},
  title   = {Numerical diffusive terms in weakly-compressible {SPH} schemes},
  journal = {Computer Physics Communications},
  year    = {2012},
  volume  = {183},
  number  = {12},
  pages   = {2570--2580},
  doi     = {10.1016/j.cpc.2012.07.006},
  note    = {The theoretical analysis of diffusive-term structure: why the plain density Laplacian (decourcy2024's AC-2) cannot hold a hydrostatic gradient at a truncated free surface, why the corrected form is really a bi-Laplacian, and the frozen-diffusion technique. Highest-priority dependency of ACSPH_PLAN.md Part 6.1.}
}

@article{molteni2009,
  author  = {Molteni, Diego and Colagrossi, Andrea},
